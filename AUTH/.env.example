PORT=3000

# MongoDB connection string - must match MONGO_USER/MONGO_PASSWORD from the root .env
MONGO_URL=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@mongo:27017/aimart-auth?authSource=admin

# Must be identical across AUTH, PRODUCT, CART, ORDER, PAYMENT, SELLER-DASHBOARD, AI-BUDDY
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_generated_secret

# Redis (used for token/session caching) - must match REDIS_PASSWORD from the root .env
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# RabbitMQ - must match RABBITMQ_USER/RABBITMQ_PASSWORD from the root .env
RABBIT_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672
