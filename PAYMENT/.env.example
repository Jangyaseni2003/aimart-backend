# Must match MONGO_USER/MONGO_PASSWORD from the root .env
MONGO_URL=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@mongo:27017/aimart-payment?authSource=admin

# Must be identical across AUTH, PRODUCT, CART, ORDER, PAYMENT, SELLER-DASHBOARD, AI-BUDDY
JWT_SECRET=replace_with_a_generated_secret

# Must match RABBITMQ_USER/RABBITMQ_PASSWORD from the root .env
RABBIT_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672

# Free-tier Test Mode keys: https://razorpay.com -> Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=TODO_GET_FROM_RAZORPAY_DASHBOARD
RAZORPAY_KEY_SECRET=TODO_GET_FROM_RAZORPAY_DASHBOARD

# Inter-service URL (Docker Compose service name)
ORDER_SERVICE_URL=http://order:3003
