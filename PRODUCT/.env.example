# Must match MONGO_USER/MONGO_PASSWORD from the root .env
MONGO_URL=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@mongo:27017/aimart-product?authSource=admin

# Must be identical across AUTH, PRODUCT, CART, ORDER, PAYMENT, SELLER-DASHBOARD, AI-BUDDY
JWT_SECRET=replace_with_a_generated_secret

# Must match RABBITMQ_USER/RABBITMQ_PASSWORD from the root .env
RABBIT_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672

# Free-tier signup: https://imagekit.io -> Dashboard -> Developer options -> API keys
IMAGEKIT_PUBLIC_KEY=TODO_GET_FROM_IMAGEKIT_DASHBOARD
IMAGEKIT_PRIVATE_KEY=TODO_GET_FROM_IMAGEKIT_DASHBOARD
IMAGEKIT_URL_ENDPOINT=TODO_GET_FROM_IMAGEKIT_DASHBOARD

# Optional: cron schedule for the dynamic pricing job. Defaults to hourly
# ("0 * * * *") if unset. Set to "* * * * *" for a fast live demo.
# PRICING_CRON_SCHEDULE=0 * * * *

# Optional: minimum time between recalculations of the same product, in ms.
# Defaults to 300000 (5 minutes) if unset. Prevents spam-clicking "Recalculate
# pricing now" from repeatedly applying the "no recent demand" price drop.
# PRICING_COOLDOWN_MS=300000
