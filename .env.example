# Read by docker-compose.yml to set up the RabbitMQ container's admin user.
# Pick your own values, then update the RABBIT_URL in every service's own
# .env file to match (AUTH, PRODUCT, ORDER, PAYMENT, NOTIFICATION,
# SELLER-DASHBOARD) - see each one's .env.example for the exact line.
RABBITMQ_USER=choose_a_username
RABBITMQ_PASSWORD=choose_a_password

# Read by docker-compose.yml to set up the MongoDB container's root user.
# Pick your own values, then update the MONGO_URL in every service's own
# .env file to match (AUTH, PRODUCT, CART, ORDER, PAYMENT, SELLER-DASHBOARD)
# - see each one's .env.example for the exact line.
MONGO_USER=choose_a_username
MONGO_PASSWORD=choose_a_password

# Read by docker-compose.yml to set up the Redis container's password.
# Pick your own value, then update REDIS_PASSWORD in AUTH/.env to match.
REDIS_PASSWORD=choose_a_password
