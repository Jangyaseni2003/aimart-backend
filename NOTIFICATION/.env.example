# Must match RABBITMQ_USER/RABBITMQ_PASSWORD from the root .env
RABBIT_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672

# Optional. Leave blank to skip email sending (service still runs, just logs a
# connection warning). To enable: create a Google Cloud project, set up an
# OAuth2 consent screen + credentials, and generate a refresh token via
# https://developers.google.com/oauthplayground for the gmail.send scope.
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
